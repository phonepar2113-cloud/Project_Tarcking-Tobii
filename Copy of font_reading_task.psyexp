      <CodeComponent name="code_5" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# === Reading Begin Routine ===&amp;#10;gaze_state['current'] = 'reading'&amp;#10;gaze_state['last_logged'] = None   # ให้ &quot;reading&quot; โผล่ 1 แถวตอนเริ่ม&amp;#10;&amp;#10;# reset counter ใน routine นี้&amp;#10;spacebar_count = 0&amp;#10;&amp;#10;# baseline: จำนวน keys ที่ค้างมาก่อนเข้า routine นี้&amp;#10;keys_base = len(key_finish_read.keys) if key_finish_read.keys else 0&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# === Reading Each Frame ===&amp;#10;&amp;#10;# วาดตำแหน่ง gaze แบบ real-time (ของเดิมคุณ)&amp;#10;if gaze_right_eye:&amp;#10;    try:&amp;#10;        gaze_x_norm, gaze_y_norm = gaze_right_eye&amp;#10;        if not math.isnan(gaze_x_norm) and not math.isnan(gaze_y_norm):&amp;#10;            gaze_x, gaze_y = convert_Tobii_units_to_PsychoPy(gaze_x_norm, gaze_y_norm)&amp;#10;            # gaze_dot.pos = (gaze_x, gaze_y)&amp;#10;            # gaze_dot.draw()&amp;#10;            # gaze_text.text = f&quot;x: {gaze_x:.2f}, y: {gaze_y:.2f}&quot;&amp;#10;            # gaze_text.draw()&amp;#10;    except Exception as e:&amp;#10;        print(f&quot;[WARNING] Failed to draw gaze dot: {e}&quot;)&amp;#10;&amp;#10;# -------------------------------&amp;#10;# ตรวจการกด spacebar (นับทุกครั้งที่กด ไม่ว่าเขากดกี่ครั้ง)&amp;#10;# ให้ marker โผล่ครั้งเดียวต่อการกด (edge detect)&amp;#10;# -------------------------------&amp;#10;keys_list = key_finish_read.keys&amp;#10;n_total = len(keys_list) if keys_list else 0&amp;#10;&amp;#10;# จำนวนการกด &quot;ใหม่&quot; ที่เกิดใน routine นี้เท่านั้น&amp;#10;n_pressed = max(0, n_total - keys_base)&amp;#10;&amp;#10;#print(&quot;n_total:&quot;, n_total, &quot;keys_base:&quot;, keys_base, &quot;n_pressed:&quot;, n_pressed)&amp;#10;&amp;#10;# ถ้ามีการกดเพิ่มจากครั้งล่าสุดใน routine นี้ -&gt; ยิง marker 1 ครั้ง&amp;#10;if n_pressed &gt; spacebar_count:&amp;#10;    spacebar_count = n_pressed&amp;#10;#    print(&quot;spacebar_count:&quot;, spacebar_count)&amp;#10;&amp;#10;    gaze_state['current'] = f'spacebar{spacebar_count}'&amp;#10;    gaze_state['last_logged'] = None" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# -------------------------------&amp;#10;# ยิง marker ตอนจบ reading&amp;#10;# -------------------------------&amp;#10;gaze_state['current'] = 'end_reading'&amp;#10;&amp;#10;# -------------------------------&amp;#10;# กันไว้ เผื่อยังไม่ set path&amp;#10;if gaze_csv_path and len(gaze_data_log) &gt; 0:&amp;#10;    routine_name = gaze_state['current'] or &quot;&quot;&amp;#10;&amp;#10;    with open(gaze_csv_path, &quot;a&quot;, newline=&quot;&quot;, encoding=&quot;utf-8&quot;) as f:&amp;#10;        writer = csv.writer(f)&amp;#10;        for row in gaze_data_log:&amp;#10;            writer.writerow([&amp;#10;                row.get(&quot;timestamp_computer&quot;, &quot;&quot;),&amp;#10;                row.get(&quot;timestamp_computer_raw&quot;, &quot;&quot;),&amp;#10;                row.get(&quot;gaze_x&quot;, &quot;&quot;),&amp;#10;                row.get(&quot;gaze_y&quot;, &quot;&quot;),&amp;#10;                row.get(&quot;state&quot;, &quot;&quot;)&amp;#10;            ])&amp;#10;&amp;#10;# ล้าง buffer เพื่อไม่กิน RAM&amp;#10;gaze_data_log.clear()&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_5" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
